# Optional. Without a key the app produces a clearly labelled extractive summary.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
SUMMARY_LANGUAGE=Slovenian

# Runtime/cache settings
DATA_DIR=./data
SEARCH_WORKERS=2
# Use "process" on WSGI/Passenger hosting so a web-worker recycle cannot stop
# an analysis after POST /api/search has returned. Local Uvicorn uses "thread".
JOB_EXECUTION_MODE=thread
# Optional absolute Python path for detached WSGI workers.
JOB_PYTHON_EXECUTABLE=
# Completed/failed job results are retained for this many days.
JOB_RETENTION_DAYS=30
HTTP_TIMEOUT_SECONDS=60
MAX_ARCHIVE_MB=500
MAX_PDF_MB=500
MAX_SUMMARY_CONTEXT_CHARS=30000

# Pseudonymous analytics events are written only after explicit consent.
PRIVACY_RETENTION_DAYS=90
# Operational request records (IP, time, parcel, browser/device metadata).
TRAFFIC_RETENTION_DAYS=30
# Random production-only secrets; leave blank for local development.
TRAFFIC_GROUP_SECRET=

# Admin panel. Generate a scrypt hash with app.admin.hash_password; never store
# the plaintext password in this file or in source control.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=8

# PIS currently presents an incomplete certificate chain to some Python clients.
# Change to true when certificate verification succeeds on your machine.
PIS_VERIFY_SSL=false

# If the ocrmypdf executable is installed, scanned PDFs are OCRed automatically.
PDF_ENABLE_OCR=true

# Cloudflare Turnstile protects POST /api/search. Create a Managed widget and
# replace these localhost test keys with production keys before deployment.
CAPTCHA_REQUIRED=true
TURNSTILE_SITE_KEY=1x00000000000000000000BB
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
