# Optional. Without a key the app produces a clearly labelled extractive summary.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
SUMMARY_LANGUAGE=Slovenian

# Runtime/cache settings
DATA_DIR=./data
SEARCH_WORKERS=2
HTTP_TIMEOUT_SECONDS=60
MAX_ARCHIVE_MB=500
MAX_PDF_MB=500
MAX_SUMMARY_CONTEXT_CHARS=30000

# Pseudonymous analytics events are written only after explicit consent.
PRIVACY_RETENTION_DAYS=90

# PIS currently presents an incomplete certificate chain to some Python clients.
# Change to true when certificate verification succeeds on your machine.
PIS_VERIFY_SSL=false

# If the ocrmypdf executable is installed, scanned PDFs are OCRed automatically.
PDF_ENABLE_OCR=true

# Cloudflare Turnstile protects POST /api/search. Create a Managed widget and
# replace these localhost test keys with production keys before deployment.
CAPTCHA_REQUIRED=true
TURNSTILE_SITE_KEY=1x00000000000000000000BB
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
